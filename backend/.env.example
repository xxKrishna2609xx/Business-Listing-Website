# Application Configuration
APP_NAME="Business Listing API"
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration (MongoDB)
# Local: mongodb://localhost:27017 or Cloud Atlas URI
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=nearlly_db

# Security & Authentication (JWT)
# Generate a strong key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_access_secret_key_change_in_production
REFRESH_SECRET_KEY=your_refresh_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin Credentials (for seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Cloudflare R2 Object Storage (Images)
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=nearlly-images
R2_PUBLIC_URL=https://your-pub-bucket-id.r2.dev

# Rate Limiting Settings
USE_RATE_LIMITING=true
DEFAULT_RATE_LIMIT=100/minute
AUTH_RATE_LIMIT=5/minute
SEARCH_RATE_LIMIT=60/minute
UPLOAD_RATE_LIMIT=10/minute
REVIEW_RATE_LIMIT=5/hour
LEAD_RATE_LIMIT=10/hour
ADMIN_RATE_LIMIT=30/minute

# File & Input Constraints
MAX_UPLOAD_SIZE=5242880
MAX_SEARCH_QUERY_LENGTH=100
MIN_PASSWORD_LENGTH=6
MAX_PASSWORD_LENGTH=128

# CORS & Trusted Hosts
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
